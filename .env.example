# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=0

# Use a long random value (at least 24 characters).
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret

# ArvanCloud Managed PostgreSQL
# IMPORTANT: Node/Prisma uses postgresql:// (not postgresql+psycopg://).
# URL-encode special characters in USER/PASSWORD when needed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# First administrator. Created automatically only if no admin exists.
ADMIN_NATIONAL_ID=1234567890
ADMIN_FULL_NAME=مدیر سامانه
