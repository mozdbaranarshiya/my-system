# Flask
SECRET_KEY=change-this-to-a-long-random-secret
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1

# ArvanCloud Managed PostgreSQL
# Replace USER, PASSWORD, HOST, PORT and DBNAME with values shown in your ArvanCloud database panel.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# First administrator. Created automatically only if no admin exists.
ADMIN_NATIONAL_ID=1234567890
ADMIN_FULL_NAME=مدیر سامانه
