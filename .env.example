# اتصال PostgreSQL مدیریت‌شده آروان‌کلاد
# مقادیر HOST/PORT/DB/USER/PASSWORD را از پنل دیتابیس آروان‌کلاد بردارید.
DATABASE_URL=postgresql+psycopg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?sslmode=require

# یک مقدار تصادفی طولانی قرار دهید؛ مثال تولید:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# مدیر اولیه فقط در اولین اجرای init-db ساخته می‌شود.
ADMIN_NATIONAL_ID=0000000000
ADMIN_NAME=مدیر سامانه

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
